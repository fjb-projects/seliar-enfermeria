#
# Local PostgreSQL/Neon connection used only by server-side database operations.
# Exact localhost, 127.0.0.1 and [::1] hosts use native pg; all other hosts keep Neon.
# For a loopback PostgreSQL instance without TLS, use sslmode=disable (not require).
# Leave unset for typechecking, builds, and schema generation.
DATABASE_URL=

# Resolution notifications remain pending until both values are configured.
EMAIL_API_KEY=
EMAIL_FROM=

# Better Auth server-only configuration. Use a random secret of at least 32 characters.
# In local development, use the browser origin, for example http://localhost:8080.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
